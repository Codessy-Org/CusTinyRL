# Backend (Go + Chi) — copy to .env and adjust. Never commit real secrets.

# --- Required ---
DATABASE_URL=postgres://shortener:change-me@localhost:5432/shortener?sslmode=disable

# --- Server ---
PORT=8080
LOG_LEVEL=info                 # debug | info | warn | error
BASE_URL=http://localhost:8080 # public origin used in returned short URLs
REQUEST_TIMEOUT=10s
SHUTDOWN_TIMEOUT=15s
AUTO_MIGRATE=true            # local dev: apply migrations at startup on `go run ./cmd/api`

# --- Redis ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Cache ---
CACHE_TTL=10m
NEGATIVE_CACHE_TTL=30s
CACHE_TIMEOUT=150ms

# --- Auth / access ---
ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_PROXY_CIDRS=           # e.g. 10.0.0.0/8 — comma separated; required behind a proxy
ALLOW_ANONYMOUS=true           # allow unauthenticated creation (IP rate limited)
AUTH_TOKEN_TTL=720h            # 30 days

# --- Slugs ---
SLUG_LENGTH=10                 # generated slug length (4..64)

# --- Rate limits (limit + window per policy) ---
RL_URL_CREATE_LIMIT=10
RL_URL_CREATE_WINDOW=1m
RL_ANON_CREATE_LIMIT=5
RL_ANON_CREATE_WINDOW=1m
RL_AUTH_LIMIT=10
RL_AUTH_WINDOW=1m
RL_ANALYTICS_LIMIT=60
RL_ANALYTICS_WINDOW=1m
RL_REDIRECT_LIMIT=300
RL_REDIRECT_WINDOW=1m

# --- Analytics ingestion ---
ANALYTICS_BUFFER_SIZE=1024
ANALYTICS_BATCH_SIZE=100
ANALYTICS_FLUSH_INTERVAL=1s
BOT_FILTER=true              # skip analytics for known bot/crawler user agents

# --- Link previews ---
PREVIEW_FETCH=true           # fetch destination title + favicon on create (SSRF-guarded)
